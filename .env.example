# Copy to .env and fill in. Nothing here is committed with a real value.

# --- Required ---
POSTGRES_PASSWORD=change-me
SQL_READER_PASSWORD=change-me-too
# Free key from https://console.groq.com (or point LLM_BASE_URL at a local Ollama and leave it empty)
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
LLM_GRADER_MODEL=llama-3.1-8b-instant
# API keys and what each caller may read. Generate keys with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEYS={"replace-with-a-random-key": {"name": "admin", "departments": ["finance", "hr", "engineering", "sales"], "clearance": "restricted", "can_ingest": true}}

# --- Models (local, free) ---
EMBEDDING_BACKEND=sentence-transformers
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DIM=384
RERANK_ENABLED=true
RERANKER_MODEL=BAAI/bge-reranker-base

ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Observability (optional) ---
# Any OTLP collector:
OTEL_EXPORTER_OTLP_ENDPOINT=
# Langfuse Cloud free tier, or the self-hosted profile (docker compose --profile observability up -d)
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Self-hosted Langfuse only. Generate with: openssl rand -hex 32
LANGFUSE_SALT=
LANGFUSE_ENCRYPTION_KEY=
LANGFUSE_NEXTAUTH_SECRET=
CLICKHOUSE_PASSWORD=
MINIO_ROOT_PASSWORD=
LANGFUSE_INIT_USER_EMAIL=
LANGFUSE_INIT_USER_PASSWORD=
